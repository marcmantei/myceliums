[
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Index a project (20+ languages, Markdown, PDF, email) into the graph. Run it when there is no index or the Index line says stale. Reuses a fresh index unless force=true; embeddings for search by meaning follow in the background. Writes only to the myceliums data directory.",
    "inputSchema": {
      "properties": {
        "force": {
          "description": "Re-index even if the index is fresh",
          "type": "boolean"
        },
        "max_age_minutes": {
          "description": "Reuse an index younger than this (default 60)",
          "type": "integer"
        },
        "path": {
          "description": "Project directory",
          "type": "string"
        },
        "skip_communities": {
          "description": "Only the community tools need them",
          "type": "boolean"
        },
        "skip_embeddings": {
          "description": "Faster, but no search by meaning",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "analyze"
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Show a function, method or class before changing it: source, signature, location, direct callers and callees. Also the follow-up for one hit of another tool.",
    "inputSchema": {
      "properties": {
        "max_source_lines": {
          "description": "Source lines shown (default 120)",
          "maximum": 5000,
          "minimum": 1,
          "type": "integer"
        },
        "repo_id": {
          "type": "string"
        },
        "symbol_name": {
          "description": "Name, qualified name, or file_path:qualified_name",
          "type": "string"
        }
      },
      "required": [
        "symbol_name"
      ],
      "type": "object"
    },
    "name": "explain_symbol"
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "What does this function or method call? Callees grouped by file, with line; depth > 1 follows the calls further down.",
    "inputSchema": {
      "properties": {
        "depth": {
          "description": "Hops; 1 = direct only (default)",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "detail": {
          "description": "compact (default): a line per hit; full: JSON with signatures",
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        },
        "limit": {
          "description": "Page size (default 20)",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "repo_id": {
          "type": "string"
        },
        "symbol_name": {
          "description": "Name, qualified name, or file_path:qualified_name",
          "type": "string"
        }
      },
      "required": [
        "symbol_name"
      ],
      "type": "object"
    },
    "name": "find_callees"
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Who calls this function or method? Callers grouped by file, with line; depth > 1 adds the callers' callers.",
    "inputSchema": {
      "properties": {
        "depth": {
          "description": "Hops; 1 = direct only (default)",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "detail": {
          "description": "compact (default): a line per hit; full: JSON with signatures",
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        },
        "limit": {
          "description": "Page size (default 20)",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "repo_id": {
          "type": "string"
        },
        "symbol_name": {
          "description": "Name, qualified name, or file_path:qualified_name",
          "type": "string"
        }
      },
      "required": [
        "symbol_name"
      ],
      "type": "object"
    },
    "name": "find_callers"
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Which functions and methods are never called? Candidates with no incoming CALLS edge, optionally under path. Entry points and callbacks look unused too: skip them with exclude_patterns.",
    "inputSchema": {
      "properties": {
        "exclude_patterns": {
          "description": "Comma-separated name substrings to skip (known entry points)",
          "type": "string"
        },
        "limit": {
          "description": "Page size (default 20)",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "path": {
          "description": "Only under this repository-relative file or directory",
          "type": "string"
        },
        "repo_id": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "find_dead_code",
    "outputSchema": {
      "$defs": {
        "DeadCodeItem": {
          "properties": {
            "end_line": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "file_path": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "qualified_name": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            },
            "start_line": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "name",
            "qualified_name",
            "kind",
            "file_path",
            "start_line",
            "end_line",
            "signature"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "index_status": {
          "description": "Index freshness: analyzed commit vs current HEAD.",
          "type": "string"
        },
        "notice": {
          "description": "Set when results were cut: how to fetch the next page.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbols": {
          "items": {
            "$ref": "#/$defs/DeadCodeItem"
          },
          "type": "array"
        },
        "total_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index_status",
        "symbols",
        "total_count"
      ],
      "title": "DeadCodeOutput",
      "type": "object"
    }
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "What breaks if I change this? For a symbol or a file: everything that calls or imports it, direct and transitive, grouped by file, then the docs naming it. With neither: the uncommitted diff (git diff HEAD) or the diff you pass.",
    "inputSchema": {
      "properties": {
        "depth": {
          "description": "Hops (default 2)",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "diff": {
          "description": "Unified diff (default without symbol_name/file_path: git diff HEAD)",
          "type": "string"
        },
        "file_path": {
          "description": "Repository-relative file to change",
          "type": "string"
        },
        "limit": {
          "description": "Page size in lines (default 50)",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "repo_id": {
          "type": "string"
        },
        "symbol_name": {
          "description": "Symbol to change (name, qualified name, or file_path:qualified_name). At most one of symbol_name, file_path, diff",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "impact_of_change"
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List the indexed repositories: id, path, indexed commit. Tools default to the repository of the working directory; pass another id as repo_id.",
    "inputSchema": {
      "properties": {
        "limit": {
          "description": "Page size (default 20)",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "list_repos",
    "outputSchema": {
      "$defs": {
        "RepoItem": {
          "properties": {
            "analyzed_at": {
              "description": "When the index was built (RFC 3339).",
              "type": "string"
            },
            "analyzed_commit": {
              "description": "Git commit the index was built from, if the project is a git checkout.",
              "type": [
                "string",
                "null"
              ]
            },
            "files": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Pass this as `repo_id` to the other tools.",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Absolute path of the project.",
              "type": "string"
            },
            "symbols": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "name",
            "path",
            "analyzed_at",
            "symbols",
            "files"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`list_repos`: the analyzed repositories.",
      "properties": {
        "notice": {
          "description": "Set when the list was cut (how to fetch the next page) or is empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "repos": {
          "description": "One page of repositories, most recently analyzed first.",
          "items": {
            "$ref": "#/$defs/RepoItem"
          },
          "type": "array"
        },
        "total_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "repos",
        "total_count"
      ],
      "title": "ReposOutput",
      "type": "object"
    }
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Find where something is implemented: functions, classes and types by name or by what the code does (\"builds the Set-Cookie header\"). Use it instead of grep to locate code: one line per hit with kind, file and lines.",
    "inputSchema": {
      "properties": {
        "explain": {
          "description": "Show each result's score breakdown",
          "type": "boolean"
        },
        "limit": {
          "description": "Page size (default 20)",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "description": "auto (default): hybrid with embeddings, else keyword",
          "enum": [
            "auto",
            "keyword",
            "semantic",
            "hybrid"
          ],
          "type": "string"
        },
        "offset": {
          "type": "integer"
        },
        "query": {
          "description": "A name (parseConfig, Item.AsString) or what the code does",
          "type": "string"
        },
        "repo_id": {
          "type": "string"
        },
        "rerank": {
          "description": "Cross-encoder rerank of the hybrid top 50: slower, more precise",
          "type": "boolean"
        },
        "tests": {
          "description": "Test code: demote (default), include, or prefer (to find tests)",
          "enum": [
            "demote",
            "include",
            "prefer"
          ],
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "search_code"
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "How does control get from one function to another? The shortest call chain from from_symbol to to_symbol, plus every function on a chain of that length (extra_calls widens it), with file and line.",
    "inputSchema": {
      "properties": {
        "extra_calls": {
          "description": "Also list chains up to this many calls longer than the shortest (default 0)",
          "maximum": 5,
          "type": "integer"
        },
        "from_symbol": {
          "description": "Start: name, qualified name, or file_path:qualified_name",
          "type": "string"
        },
        "limit": {
          "description": "Page size (default 20)",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "max_depth": {
          "description": "Longest chain in calls (default 12)",
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "repo_id": {
          "type": "string"
        },
        "to_symbol": {
          "description": "End: name, qualified name, or file_path:qualified_name",
          "type": "string"
        }
      },
      "required": [
        "from_symbol",
        "to_symbol"
      ],
      "type": "object"
    },
    "name": "trace_flow"
  }
]
