{
  // Shared options: every package and app extends this file.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "~utils/*": ["shared/utils/*"],
      "@shared/config": ["shared/config"],
    },
  },
}
